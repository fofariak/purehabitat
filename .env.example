# ---------------------------------------------------------------------------
# PureHabitat environment variables
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Supabase (partner application storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by server actions to insert applications.
# Optional if RLS insert policy allows the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Calendly (Book a Demo). Leave blank to use the built-in contact fallback.
# Example: https://calendly.com/purehabitat/demo
NEXT_PUBLIC_CALENDLY_URL=
